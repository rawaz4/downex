<?xml version="1.0"?>
<!-- BaseURL inheritance across MPD, Period, AdaptationSet and Representation. -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT8S">
  <BaseURL>https://origin.example.com/root/</BaseURL>
  <BaseURL>https://backup.example.com/root/</BaseURL>
  <Period>
    <BaseURL>period/</BaseURL>
    <AdaptationSet mimeType="video/mp4" codecs="avc1.42c01e">
      <BaseURL>set/</BaseURL>
      <SegmentTemplate media="$RepresentationID$_$Number$.m4s" duration="4"/>
      <Representation id="inherit" bandwidth="1"/>
      <Representation id="relative" bandwidth="2"><BaseURL>rep/</BaseURL></Representation>
      <Representation id="rooted" bandwidth="3"><BaseURL>/abs/</BaseURL></Representation>
      <Representation id="absolute" bandwidth="4"><BaseURL>https://other.example.net/x/</BaseURL></Representation>
      <Representation id="parent" bandwidth="5"><BaseURL>../up/</BaseURL></Representation>
    </AdaptationSet>
  </Period>
</MPD>
